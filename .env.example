# Copy to .env and fill in values from https://www.strava.com/settings/api
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
# Must match join flow (GitHub Pages callback) and Strava app settings
STRAVA_REDIRECT_URI=https://dsgaldino.github.io/Flat_and_Furious/strava/callback.html

# Paths relative to repo root (default: data/)
DATA_DIR=data
REPORTS_DIR=reports
SITE_PUBLIC_DIR=site/public

# Optional: base URL for links in WhatsApp text (no trailing slash)
# SITE_BASE_URL=https://youruser.github.io/Flat_and_Furious

GROUP_START_DATE=2022-08-01
